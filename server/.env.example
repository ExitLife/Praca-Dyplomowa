# Konfiguracja bazy danych PostgreSQL
# Format: postgresql://UŻYTKOWNIK:HASŁO@HOST:PORT/NAZWA_BAZY

# Dla lokalnej bazy danych (np. zainstalowanej na komputerze):
DATABASE_URL="postgresql://postgres:twoje_haslo@localhost:5432/kultura_app"

# Dla bazy w chmurze (np. Railway, Render, Supabase):
# DATABASE_URL="postgresql://user:password@host.example.com:5432/database_name"

# Sekretny klucz do podpisywania tokenów JWT (wymyśl własny, długi i losowy!)
JWT_SECRET="twoj_super_tajny_klucz_zmien_to_na_cos_losowego_123!"
